{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "zjsy",
  "main": "./worker/signing.js",
  "account_id": "b7b63a3778f4dd040d23f24d7959a8d8",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/sign"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "ZJSY_SIGNING_KEY_ID": "4a7bc7d421a08e6d" },
  "routes": [{ "pattern": "zjsy.zhtianqi.cn", "custom_domain": true }],
  "observability": { "enabled": false }
}
